 123          障碍物移除后智能小车继续循迹
 124          距离单位：毫米
 125          ====================================*/
 126          void TrackingAvoid(uint val)
 127          {
 128   1              uint Dis;//距离暂存变量
 129   1              Dis = GetDistance();//获取超声波测距距离,单位：毫米
 130   1              if(Dis < val)
 131   1              {       
 132   2                      do{
 133   3                              BUZZER_on;//开启蜂鸣器
 134   3                              SmartCarStops();        //停车
 135   3                              Delay1ms(60);
 136   3                              Dis = GetDistance();//获取超声波测距距离,单位：毫米
 137   3                      }while(Dis < val);
 138   2                      BUZZER_off;//关闭蜂鸣器
 139   2                      if((TrackSensorLeft == 0) && (TrackSensorRight == 0))
 140   2                      {
 141   3                              SmartCarBack(80, 80);//如果左右都出线了执行后退，回到黑线上
 142   3                      }
 143   2              }
 144   1              else
 145   1              {
 146   2                      for(Dis=0; Dis<1800; Dis++)//测距周期不低于60ms 这里借用Dis变量做循环
 147   2                      {
 148   3                              IR_Tracking();//红外循迹
 149   3                      }
 150   2              }
 151   1      }

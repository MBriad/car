  55   4                                      temp = a[i];            
  56   4                                      a[i] = a[j];            
  57   4                                      a[j] = temp;                    
  58   4                              }
  59   3                      }
  60   2              }
  61   1      
  62   1      }
  63          /*====================================
  64          函数名  ：RefreshDistance
  65          参数    ：无
  66          返回值  ：经过冒泡排序后的距离

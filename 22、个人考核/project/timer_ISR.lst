  59   2              }       
  60   1      }
  61          /*定时器1中断处理函数*/
  62          void tm1_isr() interrupt 3 using 1
  63          {
  64   1              Timer1Overflow = 1;     //计数器1溢出标志位
  65   1              EchoPin = 0;            //超声波接收端  
  66   1      }
  67          
  68          /**********************************/
  69          /*定时器1初始化*/
  70          void Timer2Init(void)//
  71          {
  72   1              T2MOD = 0x00;
  73   1              T2CON = 0x00;
  74   1              TH2 = 0;
  75   1              TL2 = 0;
  76   1      }
  77          /*定时器2中断处理函数*/
  78          void tm2_isr() interrupt 5 using 1
  79          {

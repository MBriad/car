   5          
   6          uchar PWM_T;//PWW周期
   7          /*=================================================
   8          *函数名称：IntRegInit
   9          *函数功能：中断寄存器初始化
  10          *调用：
  11          *输入：
  12          =================================================*/
  13          void IntRegInit()
  14          {
  15   1              ET0 = 1;//允许定时器0中断
  16   1              ET1 = 1;             //允许T1中断
  17   1              ET2 = 1;
  18   1              EA      = 1;//总中断允许        
  19   1      }
  20          /*定时器0初始化*/
  21          void Timer0Init(void)           //100微秒@11.0592MHz
  22          {
  23   1              TMOD |= 0x02;//定时器0，8位自动重装模块
  24   1              TH0 = 0xA4;
  25   1              TL0 = 0xA4;//100US中断一次
  26   1              TR0 = 1;//启动定时器0
  27   1      }
  28          
  29          /*定时器1初始化*/
  30          void Timer1Init(void)           
  31          {
  32   1              TMOD |= 0x10;   //定时器1工作模式1,16位定时模式。T1用测ECH0脉冲长度
  33   1              TH1 = 0;                   
  34   1        TL1 = 0;
  35   1      }
  36          /* Timer0 interrupt routine */
  37          void tm0_isr() interrupt 1 using 1
  38          {
  39   1              PWM_T++;
  40   1              if(PWM_T == 255)                //频率F=1000000/T0溢出时间*255
  41   1              {
  42   2                      PWM_T = 0;
  43   2              }
  44   1              if(RightMotorSpeed >= PWM_T)
  45   1              {
  46   2                      RightMotor_EN = 1;      //使能右马达
  47   2              }
  48   1              if(LeftMotorSpeed >= PWM_T)
  49   1              {
  50   2                      LeftMotor_EN  = 1;  //使能左马达
  51   2              }               
  52   1              if(LeftMotorSpeed < PWM_T)
  53   1              {
  54   2                      LeftMotor_EN  = 0;  //禁用左马达
C51 COMPILER V9.54   TIMER_ISR                                                             07/11/2026 13:28:32 PAGE 2   


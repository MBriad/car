  72          /*====================================
  73            Bubble sort (ascending)
  74          ====================================*/
  75          void bubble(unsigned int *a, unsigned char n)
  76          {
  77   1              unsigned int i, j, temp;
  78   1              for (i = 0; i < n - 1; i++)
  79   1              {
  80   2                      for (j = i + 1; j < n; j++)
  81   2                      {
  82   3                              if (a[i] > a[j])
  83   3                              {
  84   4                                      temp = a[i];
  85   4                                      a[i] = a[j];
  86   4                                      a[j] = temp;
  87   4                              }
  88   3                      }
  89   2              }
  90   1      }
  91          
  92          /*====================================
  93            5-sample filtered distance
  94            Drop max & min, average middle 3
  95          ====================================*/
  96          unsigned int RefreshDistance()
  97          {
  98   1              uchar num;
  99   1              uint Dist;
 100   1              for (num = 0; num < 5; num++)
 101   1              {
 102   2                      DistBuf[num] = GetDistance();
 103   2                      Delay1ms(60);
 104   2              }
 105   1              bubble(DistBuf, 5);
 106   1              Dist = (DistBuf[1] + DistBuf[2] + DistBuf[3]) / 3;
 107   1              return (Dist);
 108   1      }

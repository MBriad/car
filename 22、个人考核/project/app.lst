  30          ====================================*/
  31          static unsigned char lfsr;
  32          
  33          void InitRandom(void)
  34          {
  35   1              lfsr = TH1 ^ TL1;
  36   1              if (lfsr == 0)
  37   1                      lfsr = 0xAA;
  38   1      }

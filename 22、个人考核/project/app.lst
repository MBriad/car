  26          /*====================================
  27            LFSR pseudo-random number generator
  28            Polynomial: x^8 + x^4 + x^3 + x^2 + 1
  29          ====================================*/
  30          static unsigned char lfsr;
  31          
  32          void InitRandom(void)
  33          {
  34   1              lfsr = TL0;
  35   1              if (lfsr == 0)
  36   1                      lfsr = 0xAA;
  37   1      }
  38          
  39          unsigned char RandomByte(void)
  40          {
  41   1              unsigned char fb;
  42   1              fb = ((lfsr >> 0) ^ (lfsr >> 1) ^ (lfsr >> 2) ^ (lfsr >> 3)) & 1;
  43   1              lfsr = (lfsr >> 1) | (fb << 7);
  44   1              return lfsr;
  45   1      }

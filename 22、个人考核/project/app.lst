  73          /*====================================
  74            Bubble sort (ascending)
  75          ====================================*/
  76          void bubble(unsigned int *a, unsigned char n)
  77          {
  78   1              unsigned int i, j, temp;
  79   1              for (i = 0; i < n - 1; i++)
  80   1              {
  81   2                      for (j = i + 1; j < n; j++)
  82   2                      {
  83   3                              if (a[i] > a[j])
  84   3                              {
  85   4                                      temp = a[i];
  86   4                                      a[i] = a[j];
  87   4                                      a[j] = temp;
  88   4                              }
  89   3                      }
  90   2              }
  91   1      }

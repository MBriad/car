  93          /*====================================
  94            5-sample filtered distance
  95            Drop max & min, average middle 3
  96          ====================================*/
  97          unsigned int RefreshDistance()
  98          {
  99   1              uchar num;
 100   1              uint Dist;
 101   1              for (num = 0; num < 5; num++)
 102   1              {
 103   2                      DistBuf[num] = GetDistance();
 104   2                      Delay1ms(60);
 105   2              }
 106   1              bubble(DistBuf, 5);
 107   1              Dist = (DistBuf[1] + DistBuf[2] + DistBuf[3]) / 3;
 108   1              return (Dist);
 109   1      }

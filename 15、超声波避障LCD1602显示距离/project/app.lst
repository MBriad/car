  22          显示距离单位：毫米
  23          ====================================*/
  24          void DispDistance(unsigned int Val)
  25          {
  26   1              if((Val >= 5000) || (Timer1Overflow == 1))//超出测量范围
  27   1              {
  28   2                      Timer1Overflow = 0; //清除定时器溢出标志位
  29   2                      LCD1602_Dis_Str(0, 1, "!!! Out of range"); //LCD1602显示字符串  
  30   2              }
  31   1              else

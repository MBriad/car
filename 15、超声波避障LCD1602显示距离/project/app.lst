  33   2                      /*显示距离单位毫米*/
  34   2                      disbuff[0]=Val/1000; //距离数值千位
  35   2                      disbuff[1]=Val%1000/100;//距离数值百位
  36   2                      disbuff[2]=Val%100/10;//距离数值十位

  69          ====================================*/
  70          unsigned int RefreshDistance()
  71          {
  72   1              uchar num;
  73   1              uint Dist;
  74   1              for(num=0; num<5; num++)
  75   1              {
  76   2                      DistBuf[num] = GetDistance();

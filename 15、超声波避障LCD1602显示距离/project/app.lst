  46          void bubble(unsigned int *a,unsigned char n) /*定义两个参数：数组首地址与数组大小*/
  47          {
  48   1              unsigned int i,j,temp;  
  49   1              for(i = 0;i < n-1; i++) 
  50   1              {       
  51   2                      for(j = i + 1; j < n; j++) /*注意循环的上下限*/
  52   2                      {
  53   3                              if(a[i] > a[j])
  54   3                              {

  55          //冒泡排序
  56          void bubble(unsigned int *a,unsigned char n) /*定义两个参数：数组首地址与数组大小*/
  57          {
  58   1              unsigned int i,j,temp;  
  59   1              for(i = 0;i < n-1; i++) 
  60   1              {       
  61   2                      for(j = i + 1; j < n; j++) /*注意循环的上下限*/
  62   2                      {
  63   3                              if(a[i] > a[j])
  64   3                              {
  65   4                                      temp = a[i];            
  66   4                                      a[i] = a[j];            
  67   4                                      a[j] = temp;                    
  68   4                              }
  69   3                      }
  70   2              }
  71   1      
  72   1      }
  73          /*====================================
  74          函数名  ：RefreshDistance
  75          参数    ：无
  76          返回值  ：经过冒泡排序后的距离

  19          /*====================================
  20          函数名  ：GetDistance
  21          参数    ：无
  22          返回值  ：获取距离单位毫米
  23          描述    ：超声波测距
  24          通过发射信号到收到回响信号的时间测试距离
  25          单片机晶振11.0592Mhz
  26          注意测距周期为60ms以上
  27          ====================================*/
  28          unsigned int GetDistance()
  29          {
  30   1              unsigned int Distance = 0;      //超声波距离
  31   1              unsigned int  Time=0;           //用于存放定时器时间值
  32   1              ET0 = 0;//禁止定时器0中断
  33   1              TrigUltrasonic();       //超声波触发
  34   1              while(!EchoPin);        //判断回响信号是否为低电平
  35   1              Timer1On;                       //启动定时器1
  36   1              while(EchoPin);         //等待收到回响信号
  37   1              Timer1Off;                      //关闭定时器1
  38   1              ET0 = 1;//允许定时器0中断
  39   1              Time=TH1*256+TL1;       //读取时间
  40   1              TH1=0;
  41   1              TL1=0;                          //清空定时器
  42   1          Distance = (float)(Time*1.085)*0.17;//算出来是MM
  43   1              return(Distance);//返回距离                             
  44   1      }

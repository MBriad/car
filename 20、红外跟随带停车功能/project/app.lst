             -右转
 130   1              {
 131   2                      SmartCarRight(LeftSpeed, RightSpeed);//右转                     
 132   2              }else if((FollowSensorLeft == 0) && (FollowSensorRight == 1))//左边识别到障碍物并且右边未识别到，智能小车

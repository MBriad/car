 138   2              }
 139   1      }
 140          /*====================================
 141          函数名  ：TrackingAvoid
 142          参数    ：val设置避障触发距离
 143          返回值  ：无
 144          描述    ：智能小车黑线循迹加避障，当出现障碍物时，智能小车停车等待
 145          障碍物移除后智能小车继续循迹
 146          距离单位：毫米
 147          ====================================*/
 148          void TrackingAvoid(uint val)
 149          {
 150   1              uint Dis;//距离暂存变量
 151   1              Dis = GetDistance();//获取超声波测距距离,单位：毫米
 152   1              if(Dis < val)
 153   1              {       
 154   2                      do{
 155   3                              BUZZER_on;//开启蜂鸣器
 156   3                              SmartCarStops();        //停车
 157   3                              Delay1ms(60);
 158   3                              Dis = GetDistance();//获取超声波测距距离,单位：毫米
 159   3                      }while(Dis < val);
 160   2                      BUZZER_off;//关闭蜂鸣器
 161   2                      if((TrackSensorLeft == 0) && (TrackSensorRight == 0))
 162   2                      {
 163   3                              SmartCarBack(80, 80);//如果左右都出线了执行后退，回到黑线上
 164   3                      }
 165   2              }
 166   1              else
 167   1              {
 168   2                      for(Dis=0; Dis<1800; Dis++)//测距周期不低于60ms 这里借用Dis变量做循环
 169   2                      {
 170   3                              IR_Tracking();//红外循迹
 171   3                      }
 172   2              }
 173   1      }

line level    source

   1          #include "config.h"
   2          #include "timer_ISR.h"
   3          #include "motor.h"
   4          
   5          uchar PWM_T;//PWW周期
   6          /*=================================================
   7          *函数名称：IntRegInit
   8          *函数功能：中断寄存器初始化
   9          *调用：
  10          *输入：
  11          =================================================*/
  12          void IntRegInit()
  13          {
  14   1              ET0 = 1;//允许定时器0中断
  15   1              EA      = 1;//总中断允许        
  16   1      }
  17          /*定时器0初始化*/
  18          void Timer0Init(void)           //100微秒@11.0592MHz
  19          {
  20   1              TMOD |= 0x02;//定时器0，8位自动重装模块
  21   1              TH0 = 0xA4;
  22   1              TL0 = 0xA4;//100US中断一次
  23   1              TR0 = 1;//启动定时器0
  24   1      }
  25          
  26          /* Timer0 interrupt routine */
  27          void tm0_isr() interrupt 1 using 1
  28          {
  29   1              if(PWM_T == 255)//PWW周期               //频率F=1000000/T0溢出时间*255
  30   1              {
  31   2                      PWM_T = 0;
  32   2              }
  33   1              if(RightMotorSpeed >= PWM_T)
  34   1              {
  35   2                      RightMotor_EN = 1;      //使能右马达
  36   2              }
  37   1              if(LeftMotorSpeed >= PWM_T)
  38   1              {
  39   2                      LeftMotor_EN  = 1;  //使能左马达
  40   2              }               
  41   1              if(LeftMotorSpeed < PWM_T)
  42   1              {
  43   2                      LeftMotor_EN  = 0;  //禁用左马达
  44   2              }               
  45   1              if(RightMotorSpeed < PWM_T)
  46   1              {
  47   2                      RightMotor_EN = 0;      //禁用右马达
  48   2              }
  49   1              PWM_T++;//PWW周期控制变量       
  50   1      }


